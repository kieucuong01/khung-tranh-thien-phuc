// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  title       String
  category    String
  price       Int
  image_url   String
  description String
  createdAt   DateTime @default(now())
}

model Testimonial {
  id          String   @id @default(uuid())
  name        String
  role        String
  text        String
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id          String   @id @default(uuid())
  image_url   String
  title       String?  // Tiêu đề hoặc mô tả ngắn
  category    String   @default("Dự án") // Phân loại: VD "Khung Gỗ", "Khung Bằng Khen", "Dự án lớn"
  createdAt   DateTime @default(now())
}

model ContactRequest {
  id          String   @id @default(uuid())
  name        String
  phone       String
  serviceType String   // e.g., "go", "composite", "theu", "khac"
  notes       String?
  status      String   @default("pending") // "pending" or "contacted"
  createdAt   DateTime @default(now())
}

model Blog {
  id                    String    @id @default(uuid())
  slug                  String?   @unique
  title                 String
  excerpt               String
  content               String    @db.Text
  image_url             String
  image_alt             String?
  category              String    @default("Tin tức")
  author                String?   @default("Thiên Phúc")
  read_time             String?   @default("5 phút đọc")
  meta_title            String?
  meta_description      String?
  schema_type           String    @default("Article") // Article, FAQ, HowTo
  faq_items             Json?     // List of {q, a}
  howto_steps           Json?     // List of {name, text, image}
  featured_product_ids  String[]  @default([])
  cta_text              String?   @default("Nhận tư vấn miễn phí")
  cta_link              String?   @default("/#contact")
  tags                  String[]  @default([])
  is_published          Boolean   @default(true)
  published_at          DateTime  @default(now())
  createdAt             DateTime  @default(now())
}

model PriceItem {
  id          String   @id @default(uuid())
  category    String   // e.g., "Khung Gỗ Sồi", "Khung Composite"
  description String?  // e.g., "Bản 3-5cm, sơn màu theo yêu cầu"
  size        String   // e.g., "30x40"
  price       Int
  createdAt   DateTime @default(now())
}

model Service {
  id                    String    @id @default(uuid())
  title                 String
  slug                  String    @unique
  category              String    // e.g., "Kế toán", "Thuế", "Đăng ký kinh doanh"
  description           String
  content               String    @db.Text
  iconName              String    // Lucide icon name
  image_url             String
  featured              Boolean   @default(false)
  
  // SEO & Optimization fields
  meta_title            String?
  meta_description      String?
  is_published          Boolean   @default(true)
  published_at          DateTime  @default(now())
  related_service_ids   String[]  @default([])
  
  createdAt             DateTime  @default(now())
}
